# ==========================================
# ADITHYA AI HUB — ENVIRONMENT VARIABLES TEMPLATE
# Copy this to .env and fill in your values
# ==========================================

# 1. TELEGRAM BOT
# Get token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Get your numeric chat ID from @userinfobot on Telegram
TELEGRAM_CHAT_ID=your_numeric_chat_id_here

# 2. GEMINI AI
# Get free API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 3. GITHUB INTEGRATION
# Personal Access Token from github.com/settings/tokens (classic, 'repo' scope)
# NOTE: Named 'MAIN' because GitHub Actions reserves secrets starting with 'GITHUB_'
MAIN=your_github_personal_access_token_here
GITHUB_REPO=Adithya0805/adithya-ai-hub

# 4. BREVO NEWSLETTER & CAMPAIGNS
# API Key from Brevo -> SMTP & API -> API Keys
BREVO_API_KEY=your_brevo_api_key_here
# List ID from Brevo -> Contacts -> Lists -> List ID number
BREVO_LIST_ID=your_brevo_list_id_here
# Newsletter secret matching your Vercel API env var
NEWSLETTER_SECRET=your_custom_secret_key_here

# 5. DEV.TO CROSSPOSTING
# API Key from dev.to -> Settings -> Extensions -> DEV Community API Keys
DEVTO_API_KEY=your_devto_api_key_here

# 6. SITE & SERVER CONFIGURATION
SITE_URL=https://adithyaai.is-cool.dev
PORT=8080
