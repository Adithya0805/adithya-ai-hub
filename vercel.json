{
  "functions": {
    "api/subscribe.ts": {
      "runtime": "@vercel/node@3.x"
    },
    "api/notify.ts": {
      "runtime": "@vercel/node@3.x"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
