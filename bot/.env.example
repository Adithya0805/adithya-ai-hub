# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_numeric_telegram_chat_id

# Gemini API Key (from https://aistudio.google.com/)
